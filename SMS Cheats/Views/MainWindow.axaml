<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SMS_Cheats.ViewModels"
        x:Class="SMS_Cheats.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="SMS Cheats"
        Height="460" Width="680"
        SystemDecorations="None"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <!-- ── Title Bar ── -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                PointerPressed="TopBar_PointerPressed">
            <Grid Margin="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <TextBlock Text="◈"
                               FontSize="15"
                               Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Supermarket Save Editor"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="14"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Spacing="4">
                    <TextBlock Text="JEwaldt27 / rthomas2395"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <Button Content="✕"
                            Classes="close"
                            Click="btnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Content ── -->
        <Grid Grid.Row="1" Margin="16,14,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Stats card -->
            <Border Grid.Column="0" Grid.Row="0" Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Text="PLAYER STATS" Classes="card-title"/>

                    <StackPanel Spacing="4">
                        <TextBlock Text="LEVEL" Classes="field-label"/>
                        <TextBox Text="{Binding StoreLevel}" Classes="field"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="MONEY" Classes="field-label"/>
                        <TextBox Text="{Binding Money}" Classes="field"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="COMPLETED CHECKOUTS" Classes="field-label"/>
                        <TextBox Text="{Binding CheckoutCount}" Classes="field"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="CURRENT DAY" Classes="field-label"/>
                        <TextBox Text="{Binding CurrentDay}" Classes="field"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Store card -->
            <Border Grid.Column="2" Grid.Row="0" Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Text="STORE" Classes="card-title"/>

                    <StackPanel Spacing="4">
                        <TextBlock Text="STORE NAME" Classes="field-label"/>
                        <TextBox Text="{Binding StoreName}" Classes="field"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="MAX FUEL VEHICLES" Classes="field-label"/>
                        <ToggleButton IsChecked="{Binding MaxFuelChecked}"
                                      Content="REFUEL ALL"
                                      Classes="toggle"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Button row -->
            <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Right">
                <Button Content="Browse File"
                        Classes="secondary"
                        Command="{Binding BrowseSaveFileCommand}"/>
                <Button Content="Auto Load"
                        Classes="secondary"
                        Command="{Binding AutoLoadSaveCommand}"/>
                <Button Content="Apply Changes →"
                        Classes="primary"
                        Command="{Binding ApplyChangesCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ── Status Bar ── -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <TextBlock Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="11"
                       Foreground="{StaticResource MutedBrush}"/>
        </Border>
    </Grid>

</Window>
